# GitHub Secrets
# Settings → Secrets and variables → Actions → New repository secret
# Staging: сервер и БД — EN_*, GTM/Replain/Calendly — EN_* или RU_* по языку.

# ── Общие для всех инстансов ──────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY  = phc_xxxxxxxxxxxxxxxx
ADMIN_NOTIFY_EMAIL       = noreply@8blocks.io
UNISENDER_GO_API_KEY     = xxxxxxxx
RESEND_API_KEY           = re_xxxxxxxx
# Тест: письма клиентам уходят на этот адрес. Удалить секрет, чтобы слать реальным клиентам
EMAIL_TEST_RECIPIENT     = test@example.com


# ══════════════════════════════════════════════════════════════════════════════
# RU
# ══════════════════════════════════════════════════════════════════════════════
RU_SSH_HOST              = 1.2.3.4
RU_SSH_USER              = ubuntu
RU_SSH_PORT              = 22
RU_SSH_KEY               = -----BEGIN OPENSSH PRIVATE KEY-----...-----END OPENSSH PRIVATE KEY-----

RU_LANG                  = ru

RU_PROJECT_NAME          = 8blocks-ru

RU_DATABASE_URI          = postgresql://user:pass@localhost:5432/8blocks_ru

RU_PAYLOAD_SECRET        = secret-ru

RU_NEXT_PUBLIC_SITE_URL      = https://8blocks.ru
RU_NEXT_PUBLIC_GTM_ID        = GTM-XXXXXXX
RU_NEXT_PUBLIC_REPLAIN_ID    = 5cfc493a-e46f-4094-8448-6a22285c4399
RU_NEXT_PUBLIC_CALENDLY_URL  = https://calendly.com/care-8blocks/30min?hide_event_type_details=1&hide_gdpr_banner=1&primary_color=a10a63


# ══════════════════════════════════════════════════════════════════════════════
