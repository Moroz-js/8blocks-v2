# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/8blocks
PAYLOAD_SECRET=change-me
# Язык сборки: ru | en (переключается только пересборкой)
NEXT_PUBLIC_LANG=ru
# Базовый URL сайта (canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email ────────────────────────────────────────────────────────────────────
# RU-сборка шлёт через Unisender Go, EN/AE — через Resend. Без ключа письма не отправляются (только лог)
UNISENDER_GO_API_KEY=
# Хост API зависит от аккаунта (go1 / go2), по умолчанию go2
UNISENDER_GO_API_URL=https://go2.unisender.ru/ru/transactional/api/v1
RESEND_API_KEY=
# Адрес отправителя. Пусто — noreply@tokenomika.ru (RU) / noreply@8blocks.io (EN, AE)
EMAIL_FROM=
# Тест: письма клиентам уходят сюда (реальный получатель — в теме). Админские — как обычно, в ADMIN_NOTIFY_EMAIL
EMAIL_TEST_RECIPIENT=
# Получатель админских уведомлений (заявки, подписки). Пусто — адрес бренда инстанса
ADMIN_NOTIFY_EMAIL=

# ── Аналитика и виджеты (опционально) ────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_REPLAIN_ID=
# Пусто — дефолтная ссылка по языку
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Staging (опционально, задаётся в deploy workflow) ────────────────────────
# true — плашка staging, noindex, доступ к /staging-docs
NEXT_PUBLIC_STAGING=
# Префикс пути, например /ru для staging RU
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_STAGING_EN_URL=
NEXT_PUBLIC_STAGING_RU_URL=
# Абсолютный URL инстанса, с которого берутся медиа событий (RU staging → EN)
NEXT_PUBLIC_MEDIA_BASE_URL=
# Время сборки для плашки staging (ISO 8601)
NEXT_PUBLIC_BUILD_AT=

# ── PDF аудитов (опционально) ────────────────────────────────────────────────
# Внутренний адрес, по которому puppeteer открывает страницу аудита, по умолчанию http://127.0.0.1:$PORT
PDF_INTERNAL_BASE_URL=
# Каталог кэша PDF, по умолчанию .cache/audit-pdf
AUDIT_PDF_CACHE_DIR=
